{
  "schema_version": 1,
  "experiment_id": "BENCH-001",
  "status": "DESIGN_ONLY",
  "description": "Residency baseline design separating deterministic placement accounting from CUDA-dependent latency measurement.",
  "source": {
    "memory_attention_paper": "arXiv:2609.28399",
    "upstream_repository": "Joluck/memory-attention",
    "upstream_commit": "8176f1feaff6724af670e70d75cd9767f8e38223",
    "upstream_benchmark_blob": "9ce6143fe7df1422b2f617996395d238edd2cc1e",
    "upstream_profile_blob": "186c386e4d631197e40251c1fc14ad0e46c80318",
    "upstream_sweep_blob": "932cf4dcac6fb51135cce441810061ab245a1d51"
  },
  "claim_partition": {
    "residency": {
      "question": "How do Standard, GPU-resident MA, and CPU-offloaded MA differ in parameter placement and staging working set?",
      "evidence_lane": "deterministic_accounting",
      "cuda_required": false
    },
    "performance": {
      "question": "What latency cost or overlap remains after real CPU gather and H2D transfer on a specified CUDA system?",
      "evidence_lane": "source_faithful_cuda_measurement",
      "cuda_required": true
    }
  },
  "accounting_contract": {
    "symbols": {
      "H": "hidden_size",
      "Nh": "num_heads",
      "Nkv": "num_kv_heads",
      "Dh": "H / Nh",
      "K": "Nkv * Dh",
      "L": "num_layers",
      "V": "vocab_size",
      "B": "batch_size",
      "S": "current input sequence length",
      "G": "requested offload group_size",
      "P": "prefetch_depth",
      "Z": "ceil(L / Ge)",
      "Ge": "effective group size = min(G, L)",
      "bw": "bytes per ordinary model-weight element",
      "bm": "bytes per MA memory/staging element",
      "bkv": "bytes per KV-cache element"
    },
    "parameter_deltas": {
      "standard_value_projection_per_layer": "H*K + (K if qkv_bias else 0)",
      "ma_table_elements": "V*L*K",
      "ma_offload_gpu_parameter_delta_vs_standard": "-L*standard_value_projection_per_layer",
      "ma_offload_cpu_parameter_delta_vs_standard": "+V*L*K",
      "ma_gpu_gpu_parameter_delta_vs_standard": "V*L*K - L*standard_value_projection_per_layer",
      "standard_value_projection_bytes": "L*standard_value_projection_per_layer*bw",
      "ma_table_bytes": "V*L*K*bm",
      "ma_offload_gpu_parameter_byte_delta_vs_standard": "-standard_value_projection_bytes",
      "ma_offload_cpu_parameter_byte_delta_vs_standard": "+ma_table_bytes",
      "ma_gpu_gpu_parameter_byte_delta_vs_standard": "ma_table_bytes-standard_value_projection_bytes"
    },
    "staging_working_set": {
      "pipeline_slots": "min(P, ceil(L/effective_group))",
      "pipeline_gpu_bytes": "pipeline_slots * B*S*effective_group*K*bm",
      "pipeline_pinned_cpu_bytes": "pipeline_slots * B*S*effective_group*K*bm",
      "bulk_gpu_bytes": "B*S*L*K*bm",
      "bulk_pinned_cpu_bytes": "B*S*L*K*bm",
      "effective_group": "min(G, L)"
    },
    "persistent_kv_cache": {
      "relation": "same representation in Standard and current MA benchmark",
      "elements": "2*L*B*capacity*K",
      "note": "Report separately; it is not a parameter and BENCH-001 does not claim MA-Recall savings.",
      "bytes": "2*L*B*capacity*K*bkv"
    },
    "exclusions_from_parameter_counts": [
      "KV cache",
      "activations",
      "transfer/staging buffers",
      "deterministic RoPE buffers",
      "CPU staging copies used only to initialize GPU weights"
    ],
    "source_fidelity_notes": [
      "Requested group_size is clamped to min(group_size, num_layers) before pipeline slot allocation.",
      "Weight, MA-memory/staging, and KV-cache element widths are explicit accounting inputs and must not be silently conflated."
    ]
  },
  "cuda_protocol": {
    "variants": [
      "standard",
      "ma_gpu",
      "ma_offload"
    ],
    "modes": [
      "prefill",
      "decode"
    ],
    "requirements": [
      "CUDA",
      "BF16 support",
      "flash-attn >= 2.1"
    ],
    "source_defaults": {
      "batch_size": 8,
      "seq_len": 2048,
      "context_len": 2048,
      "hidden_size": 2048,
      "num_heads": 32,
      "num_layers": 24,
      "vocab_size": 32000,
      "group_size": 1,
      "prefetch_depth": 4,
      "decode_offload": "bulk",
      "warmup": 5,
      "repeats": 30,
      "rounds": 5
    },
    "timing_scope": {
      "included": [
        "input embedding",
        "all Transformer blocks",
        "Q/K/V or K+M construction",
        "RoPE",
        "KV cache writes",
        "FlashAttention",
        "MLP and residual paths",
        "final RMSNorm",
        "untied LM head",
        "enabled CPU gather and H2D offload work"
      ],
      "excluded": [
        "prefix construction",
        "offline memory normalization folding",
        "token-ID device-to-host transfer",
        "sampling",
        "loss/backward/optimizer"
      ]
    },
    "offload_policy": {
      "prefill": "pipeline",
      "decode_default": "bulk",
      "decode_comparison": "pipeline",
      "pipeline_mechanism": [
        "CPU gather into pinned host slots",
        "asynchronous H2D on dedicated CUDA copy stream",
        "bounded lookahead",
        "delay dependency wait until K+M consumption"
      ]
    },
    "correctness_before_timing": [
      "exact output check against reference offloader path",
      "exact written-KV check",
      "exercise reuse with changed token IDs and revisit first IDs"
    ],
    "timing_summary": "median across rounds; retain per-round samples and min/max; min/max are not confidence intervals"
  },
  "actions_role": {
    "canonical_now": [
      "strict spec validation",
      "deterministic residency and staging accounting",
      "formula fuzz/property tests",
      "cross-platform integer/byte accounting",
      "decision-support sensitivity analysis"
    ],
    "noncanonical_diagnostics": [
      "host-only microbenchmarks on shared hosted VMs"
    ],
    "prohibited_inference": [
      "Do not infer CUDA latency from CPU-only Actions runners.",
      "Do not treat bandwidth simulation as measured GPU performance."
    ]
  },
  "nonclaims": [
    "No claim that offload is latency-neutral.",
    "No claim that standard public GitHub Actions runners reproduce GPU timing.",
    "No MA-Recall or KV-cache reduction claim.",
    "No model-quality or training claim.",
    "No universal speedup claim."
  ]
}

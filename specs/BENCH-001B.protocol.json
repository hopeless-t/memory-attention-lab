        "check_correctness": true,
        "batch_size": 8,
        "logits_to_keep": 0,
        "pad_token_id": null,
        "seq_len": 2048,
        "context_len": 2048,
        "hidden_size": 2048,
        "num_heads": 32,
        "num_kv_heads": 32,
        "num_layers": 24,
        "hidden_ratio": 4,
        "intermediate_size": 5632,
        "no_fuse_swiglu": false,
        "vocab_size": 32000,
        "group_size": 1,
        "prefetch_depth": 4,
        "gpu_ma_lookup": "layerwise",
        "qkv_bias": false,
        "qk_norm": false,
        "use_gate": false,
        "window_size": null,
        "rope_theta": 10000.0,
        "norm_eps": null,
        "cpu_threads": 4,
        "fold_chunk": 1024,
        "id_pool": 16,
        "warmup": 5,
        "repeats": 30,
        "rounds": 5,
        "timing": "latency",
        "seed": 1234,
        "device": "cuda:0",
        "profile_dir": null,
        "kernel_trace": false
      },
      "json_path_policy": "non-empty string",
      "required_result_pairs": [
        ["standard", "prefill"],
        ["ma_gpu", "prefill"],
        ["ma_offload", "prefill"],
        ["standard", "decode"],
        ["ma_gpu", "decode"],
        ["ma_offload", "decode"]
      ]
    }
  },
  "result_contract": {
    "round_count_from_config": true,
    "recompute_median_min_max": true,
    "recompute_speedup_vs_standard": true,
    "require_positive_finite_timings": true,
    "require_parameter_placement_identity": true,
    "require_offload_policy_identity": true
  },
  "bundle_contract": {
    "hardware_manifest": "hardware.json",
    "benchmark_results": "bmk_results.json",
    "sha256_bind_results_from_manifest": true,
    "synthetic_fixture_allowed_only_in_validator_tests": true
  }
